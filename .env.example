# ===== إعدادات منصة واتس هم =====
PORT=4000
JWT_SECRET=غيّر-هذه-الكلمة-السريّة
PUBLIC_URL=http://localhost:4000

# ===== واتساب =====
# simulator = محاكي بدون إعدادات (افتراضي) | cloud = واتساب الأعمال (Meta)
WHATSAPP_PROVIDER=simulator
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=wassal-verify

# ===== الدفع =====
# mock = وضع تجريبي (افتراضي) | moyasar = بوابة مويصر (Apple Pay + مدى)
PAYMENT_MODE=mock
MOYASAR_SECRET_KEY=
MOYASAR_PUBLISHABLE_KEY=
MOYASAR_SANDBOX=true
