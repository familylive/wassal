# ============================================================
#  تلي هم — ملف الإعدادات (انسخه إلى server/.env واملأ القيم)
#  بعد التعبئة:  chmod 600 server/.env
# ============================================================

# --- التشغيل ---
PORT=4000
TZ=Asia/Riyadh

# --- حرج: رابط الموقع العام (عليه تُبنى روابط الفواتير والكشوف) ---
PUBLIC_URL=https://teleham.com

# --- قاعدة البيانات: خارج مجلد الكود حتى لا تضيع مع التحديثات ---
DB_PATH=/srv/teleham/data/wassal.db

# --- أمان الجلسات: نص عشوائي طويل (بدّله عند الإطلاق) ---
# لتوليده:  openssl rand -hex 32
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# --- الإدارة ---
ADMIN_PHONE=966540029999
SUPERVISOR_NAME=

# --- القناة الحالية: تليجرام ---
WHATSAPP_PROVIDER=telegram
TELEGRAM_WEBHOOK_SECRET=wassal-tg

# --- الدفع: mock للتجربة | moyasar للتحصيل الحقيقي ---
PAYMENT_MODE=mock
MOYASAR_SECRET_KEY=
MOYASAR_PUBLISHABLE_KEY=
MOYASAR_SANDBOX=true

# --- النسخ الاحتياطي: PAT بصلاحية Contents على مستودع familylive/wassal-db-backup ---
GH_BACKUP_TOKEN=

# --- تليجرام (اختياري هنا — التوكن محفوظ في قاعدة البيانات app_settings.TELEGRAM_BOT_TOKEN) ---
# TELEGRAM_BOT_TOKEN=

# --- واتساب (مؤجّل حتى فك حجب Meta) ---
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=
